{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GalNavi",
  "version": "0.1.0",
  "identifier": "com.galnavi.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    },
    "windows": [
      {
        "label": "main",
        "title": "GalNavi",
        "width": 1180,
        "height": 760,
        "minWidth": 720,
        "minHeight": 560,
        "decorations": false,
        "resizable": true,
        "maximized": false,
        "center": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "Productivity",
    "shortDescription": "Galgame 攻略路线导航器",
    "longDescription": "将 Galgame 文字攻略解析为路线图，并跟踪本地游玩进度。",
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"]
  }
}
